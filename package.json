{
  "name": "pi-for-legal-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for modular Pi legal packages.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zbzdr/pi-for-legal.git"
  },
  "homepage": "https://github.com/Zbzdr/pi-for-legal#readme",
  "bugs": {
    "url": "https://github.com/Zbzdr/pi-for-legal/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:packages": "node scripts/prepare-all-packages.mjs",
    "sync:upstream-domains": "node scripts/import-upstream-domains.mjs",
    "check": "npm run prepare:packages && node scripts/validate-package.mjs",
    "pretest": "npm run prepare:packages",
    "test": "node --test test/*.test.mjs",
    "test:rpc": "node scripts/rpc-smoke.mjs",
    "test:package": "node scripts/package-e2e.mjs",
    "test:behavior": "node scripts/behavior-eval.mjs",
    "pack:select": "node scripts/pack-packages.mjs",
    "pack:core": "node scripts/pack-packages.mjs core",
    "pack:commercial": "node scripts/pack-packages.mjs commercial",
    "pack:privacy": "node scripts/pack-packages.mjs privacy",
    "pack:regulatory": "node scripts/pack-packages.mjs regulatory",
    "pack:ai-governance": "node scripts/pack-packages.mjs ai-governance",
    "pack:employment": "node scripts/pack-packages.mjs employment",
    "pack:corporate": "node scripts/pack-packages.mjs corporate",
    "pack:litigation": "node scripts/pack-packages.mjs litigation",
    "pack:ip": "node scripts/pack-packages.mjs ip",
    "pack:product": "node scripts/pack-packages.mjs product",
    "pack:suite": "node scripts/pack-packages.mjs suite",
    "pack:all": "node scripts/pack-packages.mjs core commercial privacy regulatory ai-governance employment corporate litigation ip product suite",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "publish:all": "node scripts/publish-packages.mjs --publish"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1"
  }
}
