{
  "name": "pi-for-legal-workspace",
  "version": "0.3.0",
  "private": true,
  "description": "Workspace for the all-in-one Pi for Legal package.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zbzdr/pi-for-legal.git"
  },
  "homepage": "https://github.com/Zbzdr/pi-for-legal#readme",
  "bugs": {
    "url": "https://github.com/Zbzdr/pi-for-legal/issues"
  },
  "workspaces": [
    "packages/pi-legal-suite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare:package": "node scripts/prepare-all-packages.mjs",
    "sync:upstream-domains": "node scripts/import-upstream-domains.mjs",
    "check": "npm run prepare:package && node scripts/validate-package.mjs",
    "pretest": "npm run prepare:package",
    "test": "node --test test/*.test.mjs",
    "test:rpc": "node scripts/rpc-smoke.mjs",
    "test:package": "node scripts/package-e2e.mjs",
    "test:behavior": "node scripts/behavior-eval.mjs",
    "pack": "node scripts/pack-packages.mjs",
    "publish:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "publish": "node scripts/publish-packages.mjs --publish",
    "deprecate:legacy": "node scripts/deprecate-legacy-packages.mjs",
    "deprecate:legacy:apply": "node scripts/deprecate-legacy-packages.mjs --apply"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1"
  }
}
